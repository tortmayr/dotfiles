{
  "typescript.updateImportsOnFileMove.enabled": "always",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "breadcrumbs.enabled": true,
  "terminal.integrated.rendererType": "dom",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "workbench.colorCustomizations": {
    "activityBarBadge.background": "#80CBC4",
    "activityBar.activeBorder": "#80CBC4",
    "list.activeSelectionForeground": "#80CBC4",
    "list.inactiveSelectionForeground": "#80CBC4",
    "list.highlightForeground": "#80CBC4",
    "scrollbarSlider.activeBackground": "#80CBC450",
    "editorSuggestWidget.highlightForeground": "#80CBC4",
    "textLink.foreground": "#80CBC4",
    "progressBar.background": "#80CBC4",
    "pickerGroup.foreground": "#80CBC4",
    "tab.activeBorder": "#80CBC4",
    "notificationLink.foreground": "#80CBC4",
    "editorWidget.resizeBorder": "#80CBC4",
    "editorWidget.border": "#80CBC4",
    "settings.modifiedItemIndicator": "#80CBC4",
    "settings.headerForeground": "#80CBC4",
    "panelTitle.activeBorder": "#80CBC4",
    "breadcrumb.activeSelectionForeground": "#80CBC4",
    "menu.selectionForeground": "#80CBC4",
    "menubar.selectionForeground": "#80CBC4",
    "editor.findMatchBorder": "#80CBC4",
    "selection.background": "#80CBC440",
  },
  "terminal.integrated.fontSize": 12,
  "editor.lineHeight": 0,
  "editor.fontFamily": "FiraCode Nerd Font Mono",
  "editor.fontLigatures": true,
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",
  "eslint.workingDirectories": [],
  "eslint.format.enable": true,
  "C_Cpp.updateChannel": "Insiders",
  "editor.fontSize": 12,
  "window.openFilesInNewWindow": "on",
  "redhat.telemetry.enabled": false,
  "editor.suggest.insertMode": "replace",
  "editor.rulers": [140],
  "files.exclude": {
    "**/.classpath": true,
    "**/.factorypath": true,
    "**/.gitkeep": true,
    "**/.project": true,
    "**/.worktrees": true,
  },
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
    },
    "zsh": {
      "path": "zsh",
    },
    "fish": {
      "path": "fish",
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux",
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell",
    },
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "editor.defaultFormatter": "dbaeumer.vscode-eslint",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.bracketPairColorization.enabled": true,
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
  },
  "terminal.integrated.enableMultiLinePasteWarning": false,
  "telemetry.telemetryLevel": "off",
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "editor.stickyScroll.enabled": true,
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.colorTheme": "GitHub Dark Dimmed",
  "C_Cpp.intelliSenseEngineFallback": "Enabled",
  "C_Cpp.intelliSenseEngine": "disabled",
  "git.enableSmartCommit": true,
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "debug.javascript.unmapMissingSources": true,
  "[properties]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "playwright.reuseBrowser": true,
  "prettier.enableDebugLogs": true,
  "playwright.showTrace": false,
  "workbench.startupEditor": "none",
  "javascript.preferences.importModuleSpecifier": "relative",
  "[dotenv]": {
    "editor.defaultFormatter": "foxundermoon.shell-format",
  },
  "github.copilot.editor.iterativeFixing": false,
  "window.zoomLevel": 1,
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "window.customTitleBarVisibility": "auto",
  "typescript.preferences.importModuleSpecifier": "relative",
  "editor.minimap.enabled": false,
  "editor.guides.bracketPairs": true,
  "github.copilot.editor.enableAutoCompletions": true,
  "material-icon-theme.files.color": "#90a4ae",
  "workbench.iconTheme": "material-icon-theme",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
  },
  "window.confirmSaveUntitledWorkspace": false,
  "window.dialogStyle": "custom",
  "window.titleBarStyle": "custom",
  "window.newWindowDimensions": "maximized",
  "github.copilot.chat.codesearch.enabled": true,
  "terminal.integrated.fontLigatures.enabled": true,
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono'",
  "workbench.editor.empty.hint": "hidden",
  "interactiveWindow.promptToSaveOnClose": true,
  "files.hotExit": "off",
  "git.openRepositoryInParentFolders": "never",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "terminal.integrated.stickyScroll.enabled": false,
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "chat.commandCenter.enabled": false,
  "claudeCode.preferredLocation": "panel",
  "github.copilot.nextEditSuggestions.enabled": true,
  "search.exclude": {
    "**/worktrees": true,
  },
  "workbench.editor.enablePreview": false,
  "[plaintext]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
  },
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",
  "diffEditor.renderSideBySide": false,
  "githubPullRequests.pullBranch": "never",
  "extensions.autoUpdate": "off",
  "workbench.sideBar.location": "right",
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://biomejs.dev": true
  },
  "biome.lsp.watcher.kind": "recommended",
  "biome.configurationPath": ".config/biome.json",
}
